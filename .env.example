# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Real platform API credentials (see docs/platform-setup.md) ---
# Meta for Developers app (Facebook Login + Instagram Basic):
META_APP_ID=""
META_APP_SECRET=""
# Graph API version, e.g. v23.0
META_GRAPH_VERSION="v26.0"

# Threads needs its own Meta app (use cases can't be combined in one app).
# Leave empty to reuse META_APP_ID/META_APP_SECRET.
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# Instagram API with Instagram Login (use case "Manage messaging & content on
# Instagram" — usually the same app as Threads). Empty = reuse THREADS_*.
IG_APP_ID=""
IG_APP_SECRET=""

# TikTok for Developers app (Open API, OAuth 2.0 + PKCE):
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Google Cloud project with an OAuth client (YouTube Data API v3):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth helper server port (vite proxies /auth and /api here)
OAUTH_SERVER_PORT="8787"

# Optional: override the universal data directory for media storage.
# Default on Windows: %LOCALAPPDATA%\RelateSocial  (media lives in <dir>\media\YYYY-MM-DD\)
# RELATE_DATA_DIR="D:\\RelateSocialData"

# --- Folder browsing ---
# Limit folder browsing to specific trees (os.path.delimiter separated).
# Default: home folder + mounted volumes (/media, /mnt, /run/media, /Volumes, drives).
MEDIA_BROWSE_ROOTS=""

# Turn the folder browser off entirely.
# Unset = on. Off = 0, off, false, no (case-insensitive).
MEDIA_BROWSE="1"

# Allow folder browsing from other devices (phone, second laptop, tunnel).
# 0 = only the computer running the app may browse; 1 = anyone who can reach it.
MEDIA_BROWSE_REMOTE="0"

# Max subfolders returned per listing.
FS_LIST_LIMIT="1000"

# ---------- Publishing ----------
# Public HTTPS address Meta/Instagram and Threads download media files from.
# Falls back to APP_URL; localhost is rejected because Meta curls the URL.
# Point it at your Cloudflare tunnel or domain while developing.
# PUBLIC_MEDIA_BASE_URL="https://relate.example.id"

# Scheduler tuning (backend local clock decides when a post is due).
# SCHEDULE_TICK_SECONDS="20"      # how often the scheduler looks for due posts
# SCHEDULE_GRACE_MINUTES="120"    # publish late up to this many minutes, then mark failed
# PUBLISH_MAX_ATTEMPTS="3"        # retries with 2/10/30 minute backoff
# PUBLISH_VIDEO_TIMEOUT_MS="300000"  # how long to wait for Instagram to process a Reel
# Humanized scheduling: scheduled posts publish at a random moment 0..N minutes
# after their time, so timestamps are not exactly on the minute. 0 = off.
PUBLISH_JITTER_MINUTES="0"

# --- Access gate (LAN password) ---
# When set, every /api and /auth call from an unauthenticated browser needs a
# session cookie obtained via the password screen. Unset = open (localhost dev).
# Warning: over plain HTTP this deters casual access only, not attackers.
# APP_PASSWORD="your-password"
